#!/usr/bin/env python3
"""
Download and build a dataset for an experiment, independently of training.

`spktrain` builds its dataset inside the training run, which means every run
re-checks (and, on a cold cache, re-downloads and re-converts) the data, and
every run writes its own `split.npz` into its own hydra run directory. When you
are comparing several training configurations you want the opposite: build the
data once, freeze one split, and point every run at both.

This script composes the *same* hydra config `spktrain` does, so the dataset and
the transforms are identical to what the experiment would have produced, then
runs `prepare_data()` (download + build) and `setup()` (partition + split file)
and stops.

Examples:
    # build exactly what `spktrain experiment=qm9_atomwise` would build
    spkdata experiment=qm9_atomwise run.data_dir=./data

    # build a data config directly, without an experiment
    spkdata data=qm9 run.data_dir=./data

    # freeze a split shared by every run of a control experiment
    spkdata experiment=qm9_atomwise run.data_dir=./data \
        --split-file ./data/qm9_split_seed0.npz --seed 0

    # then, for each configuration under test:
    spktrain experiment=qm9_atomwise run.data_dir=./data \
        data.split_file=$(realpath ./data/qm9_split_seed0.npz) ...

    # report per-atom statistics of the training partition
    spkdata experiment=qm9_atomwise run.data_dir=./data --stats energy_U0
"""

import argparse
import logging
import os
import sys

# registers the `uuid`, `petname` and `tmpdir` OmegaConf resolvers used by the
# shared configs, so composing `train.yaml` here behaves as it does in spktrain
import schnetpack.cli  # noqa: F401

import hydra
from hydra import compose, initialize_config_dir
from hydra.core.hydra_config import HydraConfig
from omegaconf import DictConfig, OmegaConf, open_dict
from pytorch_lightning import seed_everything

import schnetpack as spk
import schnetpack.properties as properties
from schnetpack.data import AtomsDataFormat, create_dataset, load_dataset
from schnetpack.utils import str2class
from schnetpack.utils.script import print_config

log = logging.getLogger("spkdata")

CONFIG_DIR = os.path.join(os.path.dirname(spk.__file__), "configs")


def build_argparser():
    parser = argparse.ArgumentParser(
        prog="spkdata",
        description=(
            "Download and build an experiment's dataset without training. "
            "Any argument that is not one of the flags below is passed through "
            "to hydra as a config override, e.g. `experiment=qm9_atomwise` or "
            "`run.data_dir=./data`."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument(
        "--split-file",
        default=None,
        help="Where to write the partition file. Overrides `data.split_file`. "
        "Relative paths are resolved against the current directory, not the "
        "hydra run directory, so the result is safe to share between runs. "
        "Defaults to `<datapath stem>_split.npz` next to the dataset.",
    )
    parser.add_argument(
        "--seed",
        type=int,
        default=None,
        help="Seed used to draw the split. Pass the same seed to reproduce it.",
    )
    parser.add_argument(
        "--no-split",
        action="store_true",
        help="Only download and build the dataset; do not partition it or write "
        "a split file.",
    )
    parser.add_argument(
        "--stats",
        metavar="PROPERTY",
        action="append",
        default=[],
        help="Compute mean/stddev of PROPERTY over the training partition. "
        "Repeatable. Requires a full pass over the training data.",
    )
    parser.add_argument(
        "--stats-total",
        action="store_true",
        help="Report --stats per system instead of per atom.",
    )
    parser.add_argument(
        "--keep-atomrefs",
        action="store_true",
        help="Do not subtract atomrefs before computing --stats.",
    )
    parser.add_argument(
        "--format",
        choices=["ase", "lmdb", "both"],
        default=None,
        help="Which on-disk backend(s) to produce. Defaults to whatever the "
        "config's `datapath` extension implies (.db=ase, .lmdb=lmdb). "
        "`both` builds one and converts to the other, so the raw data is only "
        "downloaded and parsed once.",
    )
    parser.add_argument(
        "--benchmark",
        action="store_true",
        help="After building, time random-access and sequential reads on every "
        "format that exists, and report the difference.",
    )
    parser.add_argument(
        "--benchmark-n",
        type=int,
        default=2000,
        help="Number of systems to read per benchmark phase (default 2000).",
    )
    parser.add_argument(
        "--config-dir",
        default=None,
        help="Additional directory to search for configs, for your own "
        "`experiment/<name>.yaml`. The current directory and `./configs` are "
        "already searched.",
    )
    parser.add_argument(
        "--print-config",
        action="store_true",
        help="Print the resolved data config before building.",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="List the available `data=` and `experiment=` config names and exit.",
    )
    return parser


def list_configs():
    for group in ("data", "experiment"):
        group_dir = os.path.join(CONFIG_DIR, group)
        names = sorted(
            os.path.splitext(f)[0]
            for f in os.listdir(group_dir)
            if f.endswith(".yaml")
        )
        print(f"\n{group}=")
        for name in names:
            print(f"    {name}")
    print()


def compose_config(overrides, config_dir=None):
    """Compose `train.yaml` exactly as spktrain does, minus the hydra.main wrapper.

    `@hydra.main` would chdir into a fresh run directory and write logs there,
    which is precisely what we do not want for a data-prep step. The compose API
    gives the same config without those side effects, but it does not populate
    `HydraConfig`, which `run.work_dir: ${hydra:runtime.cwd}` needs -- so we set
    it explicitly.
    """
    # `train.yaml` puts `${oc.env:PWD}` on the config search path
    os.environ.setdefault("PWD", os.getcwd())

    if config_dir is not None:
        searchpath = [
            f"file://{os.path.abspath(config_dir)}",
            "file://${oc.env:PWD}",
            "file://${oc.env:PWD}/configs",
        ]
        overrides = overrides + [f"hydra.searchpath=[{','.join(searchpath)}]"]

    with initialize_config_dir(config_dir=CONFIG_DIR, version_base="1.2"):
        config = compose(
            config_name="train",
            overrides=overrides,
            return_hydra_config=True,
        )
        # `set_config` takes a masked copy, so popping afterwards is safe
        HydraConfig.instance().set_config(config)
        with open_dict(config):
            config.pop("hydra", None)
        # resolve inside the context, while the resolvers still have what they need
        OmegaConf.resolve(config)
    return config


FORMATS = {"ase": AtomsDataFormat.ASE, "lmdb": AtomsDataFormat.LMDB}
EXTENSIONS = {"ase": ".db", "lmdb": ".lmdb"}


def path_for(datapath, fmt):
    """Swap a datapath's extension for the one belonging to `fmt`."""
    return os.path.splitext(datapath)[0] + EXTENSIONS[fmt]


def convert_dataset(src_path, src_fmt, dst_path, dst_fmt, chunk=2000):
    """Rewrite a built dataset into the other backend.

    Reading the raw archive again is the expensive part of `prepare_data`, so
    `--format both` builds one backend and converts, rather than downloading
    and parsing twice.
    """
    from ase import Atoms

    src = load_dataset(src_path, FORMATS[src_fmt])
    props = list(src.available_properties)
    dst = create_dataset(
        datapath=dst_path,
        format=FORMATS[dst_fmt],
        distance_unit=(src.metadata or {}).get("_distance_unit", "Ang"),
        property_unit_dict={p: src.units[p] for p in props},
        atomrefs={k: list(v) for k, v in (src.atomrefs or {}).items()},
    )

    log.info(f"Converting {len(src)} systems {src_fmt} -> {dst_fmt}")
    atoms_buf, prop_buf = [], []
    written = 0
    for i in range(len(src)):
        row = src[i]
        atoms_buf.append(
            Atoms(
                numbers=row[properties.Z].numpy(),
                positions=row[properties.R].numpy(),
                cell=row[properties.cell].numpy().reshape(3, 3),
                pbc=row[properties.pbc].numpy(),
            )
        )
        prop_buf.append({p: row[p].numpy() for p in props})
        if len(prop_buf) >= chunk:
            dst.add_systems(property_list=prop_buf, atoms_list=atoms_buf)
            written += len(prop_buf)
            log.info(f"  {written}/{len(src)}")
            atoms_buf, prop_buf = [], []
    if prop_buf:
        dst.add_systems(property_list=prop_buf, atoms_list=atoms_buf)
        written += len(prop_buf)

    if hasattr(dst, "close"):
        dst.close()

    check = load_dataset(dst_path, FORMATS[dst_fmt])
    if len(check) != len(src):
        raise RuntimeError(
            f"conversion wrote {len(check)} systems, source has {len(src)}"
        )
    log.info(f"Converted {written} systems -> {dst_path}")


def dir_size(path):
    """LMDB may be a directory; ASE is a single file."""
    if os.path.isfile(path):
        return os.path.getsize(path)
    total = 0
    for root, _, files in os.walk(path):
        for f in files:
            total += os.path.getsize(os.path.join(root, f))
    return total


def benchmark_formats(paths, n_samples, seed=0):
    """Time random-access and sequential reads on each built backend."""
    import random
    import time

    rows = []
    for fmt, path in paths.items():
        ds = load_dataset(path, FORMATS[fmt])
        total = len(ds)
        n = min(n_samples, total)

        # touch a few rows first so we are not timing one-off env/connection setup
        for i in range(min(32, total)):
            ds[i]

        rng = random.Random(seed)
        idx = [rng.randrange(total) for _ in range(n)]
        t0 = time.perf_counter()
        for i in idx:
            ds[i]
        t_rand = time.perf_counter() - t0

        t0 = time.perf_counter()
        for i in range(n):
            ds[i]
        t_seq = time.perf_counter() - t0

        rows.append(
            {
                "fmt": fmt,
                "path": path,
                "n": n,
                "size": dir_size(path),
                "rand_s": t_rand,
                "seq_s": t_seq,
                "rand_rate": n / t_rand if t_rand else float("inf"),
                "seq_rate": n / t_seq if t_seq else float("inf"),
            }
        )

    print()
    print("=" * 72)
    print(f"read benchmark ({rows[0]['n']} systems per phase, warm page cache)")
    print("=" * 72)
    print(f"  {'backend':<8}{'on disk':>12}{'random/s':>14}{'sequential/s':>16}")
    for r in rows:
        print(
            f"  {r['fmt']:<8}{r['size']/1e6:>10.1f} MB"
            f"{r['rand_rate']:>14,.0f}{r['seq_rate']:>16,.0f}"
        )

    if len(rows) == 2:
        a, b = rows
        print()
        print(
            f"  {b['fmt']} vs {a['fmt']}: "
            f"random {b['rand_rate']/a['rand_rate']:.2f}x, "
            f"sequential {b['seq_rate']/a['seq_rate']:.2f}x, "
            f"size {b['size']/a['size']:.2f}x"
        )
    print(
        "\n  Note: warm page cache, single process, no transforms. Real training\n"
        "  throughput also depends on transforms, batch size and worker count."
    )
    return rows


def describe_dataset(dataset):
    metadata = dataset.metadata or {}
    print(f"  systems              : {len(dataset)}")
    print(f"  distance unit        : {metadata.get('_distance_unit', '?')}")
    atomrefs = dataset.atomrefs or {}
    print("  properties           :")
    units = dataset.units
    for prop in dataset.available_properties:
        unit = units.get(prop, "?")
        ref = " (has atomrefs)" if prop in atomrefs else ""
        print(f"      {prop:<32} [{unit}]{ref}")


def main():
    logging.basicConfig(
        level=logging.INFO, format="%(asctime)s | %(levelname)-8s | %(message)s"
    )
    parser = build_argparser()
    args, overrides = parser.parse_known_args()

    if args.list:
        list_configs()
        return 0

    config: DictConfig = compose_config(overrides, config_dir=args.config_dir)

    if "data" not in config or OmegaConf.is_missing(config.data, "datapath"):
        parser.error(
            "No dataset selected. Pass `experiment=<name>` or `data=<name>`, "
            "and `run.data_dir=<dir>`. Run `spkdata --list` to see the options."
        )

    if args.seed is not None:
        seed_everything(seed=args.seed, workers=True)
        log.info(f"Seeded split with {args.seed}")
    else:
        log.warning(
            "No --seed given; the split will not be reproducible. Pass --seed to "
            "freeze a split you intend to reuse across training runs."
        )

    datapath = os.path.abspath(config.data.datapath)
    os.makedirs(os.path.dirname(datapath) or ".", exist_ok=True)

    # Which backend(s) to end up with. Default: whatever the config's extension
    # says. `both` builds one and converts, so parsing happens once.
    config_fmt = "lmdb" if datapath.endswith(".lmdb") else "ase"
    if args.format is None:
        wanted = [config_fmt]
    elif args.format == "both":
        wanted = [config_fmt, "lmdb" if config_fmt == "ase" else "ase"]
    else:
        wanted = [args.format]

    primary = wanted[0]
    datapath = path_for(datapath, primary)
    with open_dict(config):
        config.data.datapath = datapath

    # Keep the split file out of whatever directory this happens to run in.
    if not args.no_split:
        split_file = args.split_file or f"{os.path.splitext(datapath)[0]}_split.npz"
        with open_dict(config):
            config.data.split_file = os.path.abspath(split_file)

    if args.print_config:
        print_config(config.data, resolve=True)

    log.info(f"Instantiating datamodule <{config.data._target_}>")
    datamodule = hydra.utils.instantiate(
        config.data,
        train_sampler_cls=(
            str2class(config.data.train_sampler_cls)
            if config.data.get("train_sampler_cls")
            else None
        ),
    )

    existed = os.path.exists(datapath)
    log.info(f"Preparing data at {datapath}" + (" (already present)" if existed else ""))
    datamodule.prepare_data()

    # the datamodule already ran the path through resolve_format in __init__
    resolved_path = os.path.abspath(datamodule.datapath)
    dataset = load_dataset(resolved_path, datamodule.format)

    built = {primary: resolved_path}
    for fmt in wanted[1:]:
        target = path_for(resolved_path, fmt)
        if os.path.exists(target):
            log.info(f"{fmt} dataset already present at {target}")
        else:
            convert_dataset(resolved_path, primary, target, fmt)
        built[fmt] = target

    for fmt, path in built.items():
        print("\n" + "=" * 72)
        print(f"dataset [{fmt}]: {path}")
        print("=" * 72)
        describe_dataset(load_dataset(path, FORMATS[fmt]))

    if args.benchmark:
        benchmark_formats(built, args.benchmark_n)

    if args.no_split:
        print("\nSplit skipped (--no-split).")
        return 0

    log.info("Partitioning dataset")
    datamodule.setup("fit")

    print("\n  partition sizes      :")
    print(f"      train {len(datamodule.train_idx)}")
    print(f"      val   {len(datamodule.val_idx)}")
    print(f"      test  {len(datamodule.test_idx)}")
    print(f"\n  split file           : {config.data.split_file}")

    transforms = config.data.get("transforms") or []
    if transforms:
        print("  transforms           :")
        for t in transforms:
            print(f"      {t['_target_']}")

    for prop in args.stats:
        if prop not in dataset.available_properties:
            log.error(f"`{prop}` is not in this dataset; skipping --stats for it.")
            continue
        remove_atomref = not args.keep_atomrefs and bool(
            (datamodule.train_dataset.atomrefs or {}).get(prop) is not None
        )
        divide_by_atoms = not args.stats_total
        log.info(f"Computing statistics for `{prop}` (one full pass over train)")
        mean, stddev = datamodule.get_stats(
            prop, divide_by_atoms=divide_by_atoms, remove_atomref=remove_atomref
        )
        scope = "per atom" if divide_by_atoms else "per system"
        refs = "atomrefs removed" if remove_atomref else "atomrefs kept"
        print(f"\n  stats[{prop}] ({scope}, {refs}):")
        print(f"      mean   {mean.item():.6f}")
        print(f"      stddev {stddev.item():.6f}")

    print(
        "\nReuse this build across training runs with:\n"
        f"    spktrain <your overrides> run.data_dir={os.path.dirname(resolved_path)} "
        f"data.split_file={config.data.split_file}\n"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
