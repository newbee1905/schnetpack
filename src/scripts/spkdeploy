#!/usr/bin/env python3
import copy
import torch
import torch.nn as nn
from schnetpack.transform import CastTo64, CastTo32, AddOffsets
import argparse


# This script is supposed to take a pytorch model and save a just in time compiled version of it.
# This is needed to run the model with LAMMPS.
# For further info see examples/howtos/lammps.rst

# Note that this script is designed for models that predict atomic forces via automatic differentiation (utilizing response modules). 
# Hence this script will not work for models without response modules.


def get_jit_model(model, keep_float64=False):
    """Script `model`, leaving the caller's model untouched.

    `keep_float64` retains CastTo64 and leaves AddOffsets.mean in float64, so
    the scripted model reproduces the original bit for bit. The default drops
    both, which is what the LAMMPS pair_style expects; keeping them yields a
    model whose outputs are float64 and so is not usable from that interface.
    It is worth setting for standalone inference: the offsets summed by
    AddOffsets are of order -1e4 eV, where float32 resolves to about 1 meV, so
    the default costs ~0.24 meV on a QM9 model.

    Scripting needs a postprocessor list with the type casts dropped and the
    offset mean in float32. Both of those used to be written straight onto the
    caller's model: `model.postprocessors` was replaced, and AddOffsets.mean was
    downcast on the shared postprocessor object. The CLI never noticed because
    it exits immediately afterwards, but anything that keeps using the model --
    evaluating it, or deploying several checkpoints in a loop -- silently got a
    model that had lost CastTo64 and returned float32.

    So: copy the postprocessor being modified rather than editing it in place,
    and restore the original list once scripting is done. Only the postprocessor
    is copied, not the whole model, so this costs nothing for a large network.
    """
    original_postprocessors = model.postprocessors
    drop = [CastTo32] if keep_float64 else [CastTo64, CastTo32]

    jit_postprocessors = nn.ModuleList()
    for postprocessor in original_postprocessors:
        # ignore type casting
        if type(postprocessor) in drop:
            continue
        # ensure offset mean is float, on a copy so the caller's model keeps
        # its float64 mean
        if type(postprocessor) == AddOffsets and not keep_float64:
            postprocessor = copy.deepcopy(postprocessor)
            postprocessor.mean = postprocessor.mean.float()

        jit_postprocessors.append(postprocessor)

    model.postprocessors = jit_postprocessors
    try:
        return torch.jit.script(model)
    finally:
        model.postprocessors = original_postprocessors


def save_jit_model(model, model_path, keep_float64=False):
    jit_model = get_jit_model(model, keep_float64=keep_float64)

    # add metadata
    metadata = dict()
    metadata["cutoff"] = str(jit_model.representation.cutoff.item()).encode("ascii")

    torch.jit.save(jit_model, model_path, _extra_files=metadata)


if __name__ == "__main__":

    parser = argparse.ArgumentParser()
    parser.add_argument("model_path")
    parser.add_argument("deployed_model_path")
    parser.add_argument("--device", type=str, default="cpu")
    parser.add_argument(
        "--keep-float64",
        action="store_true",
        help="retain CastTo64 so the scripted model matches the original "
        "exactly. Not usable from the LAMMPS interface, which expects float32.",
    )
    args = parser.parse_args()

    model = torch.load(args.model_path, map_location=args.device, weights_only=False)
    save_jit_model(model, args.deployed_model_path, keep_float64=args.keep_float64)

    print(f"stored deployed model at {args.deployed_model_path}.")
